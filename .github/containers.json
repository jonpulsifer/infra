{
  "_comment": "Allowlist for the containers workflow. Every image produced by a Dockerfile under apps/ or images/ must appear in exactly one of these lists. detect-containers.sh fails CI if a Dockerfile is left unclassified, so a new app can't be silently published or silently dropped. 'build' = published to GHCR; 'ignore' = has a Dockerfile but is intentionally not published here.",
  "build": [
    "ai-agents",
    "ddnsd",
    "flameboss",
    "netbench",
    "rackstat",
    "atlantis",
    "actions-runner",
    "hub",
    "kthx",
    "mate",
    "mate-sandbox",
    "smiirl",
    "spindrift",
    "spindrift-demo",
    "spindrift-verifier",
    "switchboard"
  ],
  "deploy": {
    "actions-runner": [
      "clusters/base/apps/arc/infra.yaml"
    ],
    "atlantis": [
      "clusters/offsite/apps/atlantis/helm-release.yaml"
    ],
    "flameboss": [
      "clusters/folly/monitoring/flameboss.yaml"
    ],
    "hub": [
      "clusters/offsite/apps/hub/helm-release.yaml"
    ],
    "kthx": [
      "clusters/offsite/apps/kthx/helm-release.yaml"
    ],
    "mate": [
      "clusters/offsite/apps/mate/deployment.yaml"
    ],
    "mate-sandbox": [
      "clusters/offsite/apps/mate/deployment.yaml"
    ],
    "netbench": [
      "clusters/base/apps/iperf3/iperf3-daemonset.yaml",
      "clusters/folly/apps/netbench/03-deployment.yaml"
    ],
    "rackstat": [
      "clusters/folly/apps/tronbyt/07-rackstat-deployment.yaml"
    ],
    "smiirl": [
      "clusters/folly/apps/smiirl/02-deployment.yaml"
    ],
    "spindrift": [
      "clusters/offsite/apps/spindrift/helm-release.yaml"
    ],
    "switchboard": [
      "clusters/offsite/apps/elevenlabs/switchboard.yaml"
    ]
  },
  "ignore": [
    "bashcurljq",
    "kernel-builder",
    "openclaw",
    "workstation",
    "hermes",
    "clankerbanker",
    "slingshot"
  ]
}
