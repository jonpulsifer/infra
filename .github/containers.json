{
  "_comment": "Allowlist for the containers workflow. Every image produced by a Dockerfile under apps/ or images/ must appear in exactly one of these lists. detect-containers.sh fails CI if a Dockerfile is left unclassified, so a new app can't be silently published or silently dropped. 'build' = published to GHCR; 'ignore' = has a Dockerfile but is intentionally not published here, such as an app the kthx engine builds from its own kthx.yaml.",
  "build": [
    "ddnsd",
    "flameboss",
    "fleet-boot-alpine",
    "netbench",
    "rackstat",
    "atlantis",
    "actions-runner",
    "hub",
    "kthx",
    "mate",
    "mate-sandbox",
    "mate-voice",
    "smiirl",
    "spire-agent-tpm",
    "spiffe-adc",
    "spiffe-adc-test",
    "kthx-engine",
    "kthx-engine-verifier",
    "gcsfuse",
    "keylime-agent",
    "keylime-server",
    "switchboard",
    "tally",
    "tally-ocr",
    "tink-agent-autoid",
    "tink-attest",
    "tink-reprovision-tools",
    "weather"
  ],
  "deploy": {
    "actions-runner": [
      "clusters/base/apps/arc/infra.yaml"
    ],
    "atlantis": [
      "clusters/offsite/apps/atlantis/helm-release.yaml"
    ],
    "fleet-boot-alpine": [
      "clusters/folly/talos/netboot.json"
    ],
    "flameboss": [
      "clusters/folly/monitoring/flameboss.yaml"
    ],
    "gcsfuse": [
      "clusters/offsite/apps/kthx-sites/deployment.yaml"
    ],
    "hub": [
      "clusters/offsite/apps/hub/helm-release.yaml"
    ],
    "kthx": [
      "clusters/offsite/apps/kthx/helm-release.yaml"
    ],
    "kthx-engine": [
      "clusters/offsite/apps/kthx-engine/helm-release.yaml"
    ],
    "mate": [
      "clusters/offsite/apps/mate/deployment.yaml"
    ],
    "mate-sandbox": [
      "clusters/offsite/apps/mate/sandbox-image.yaml"
    ],
    "mate-voice": [
      "clusters/offsite/apps/mate/voice-deployment.yaml"
    ],
    "netbench": [
      "clusters/base/apps/iperf3/iperf3-daemonset.yaml",
      "clusters/folly/apps/netbench/03-deployment.yaml"
    ],
    "rackstat": [
      "clusters/folly/apps/tronbyt/07-rackstat-deployment.yaml"
    ],
    "smiirl": [
      "clusters/folly/apps/smiirl/02-deployment.yaml"
    ],
    "spire-agent-tpm": [
      "clusters/folly/apps/spire/daemonset.yaml"
    ],
    "spiffe-adc": [
      "clusters/folly/apps/spire-test/job.yaml",
      "clusters/folly/apps/spire-test/clients.yaml"
    ],
    "spiffe-adc-test": [
      "clusters/folly/apps/spire-test/clients.yaml"
    ],
    "switchboard": [
      "clusters/folly/apps/pbx/switchboard.yaml",
      "clusters/offsite/apps/elevenlabs/switchboard.yaml"
    ],
    "tally": [
      "clusters/folly/apps/tally/deployment.yaml"
    ],
    "tally-ocr": [
      "clusters/folly/apps/tally/ocr-worker.yaml"
    ],
    "tink-agent-autoid": [
      "clusters/folly/talos/netboot.json"
    ],
    "tink-attest": [
      "clusters/folly/apps/spire/tpm-reattest.yaml"
    ],
    "tink-reprovision-tools": [
      "clusters/folly/tinkerbell/template.yaml",
      "clusters/folly/tinkerbell/template-image.yaml"
    ],
    "weather": [
      "clusters/offsite/apps/weather/deployment.yaml"
    ]
  },
  "ignore": [
    "bashcurljq",
    "clankerbanker",
    "kthx-engine-demo",
    "slingshot"
  ]
}
