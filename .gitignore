# ─── Nix / NixOS ──────────────────────────────────────────────────────────────
result
result*
*.nixexpr
*.nixpkgs
*.iso
*.img
*.backup
*.wsl
*.zstd

# ─── Terraform ───────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars

# ─── Build Artifacts ─────────────────────────────────────────────────────────
build/
dist/
out/
*.tgz
# Source that happens to be named after one: spindrift's build adapter is the
# contract for build backends, not a build output.
!apps/spindrift/src/adapters/build/

# ─── Logseq (docs/ wiki graph) ───────────────────────────────────────────────
# Track pages/journals + logseq/{config.edn,custom.css}; ignore app state.
docs/logseq/bak/
docs/logseq/.recycle/
docs/logseq/graphs-txid.edn
docs/logseq/broken-config.edn
docs/logseq/metadata.edn
docs/.trash/

# ─── Agent / AI Tooling ──────────────────────────────────────────────────────
# Ignore local/personal Claude config, but track the shared session-start hook
# + settings so Claude Code on the web bootstraps the toolchain.
.claude/*
!.claude/settings.json
!.claude/hooks/
# Claude Code only discovers skills in .claude/skills; .agents/skills is the
# tool-agnostic source. This symlink is how the repo's skills actually load.
!.claude/skills
.claude/settings.local.json
.agents/*
!.agents/skills/
!.agents/skills/**
.pi-subagents/

# ─── Node / Bun ──────────────────────────────────────────────────────────────
# Root is a Bun workspace (apps/*, packages/*); bun.lock is tracked.
node_modules/
.turbo/

# ─── Tool caches ─────────────────────────────────────────────────────────────
# aquasecurity/trivy-action caches its vulnerability DB in the workspace at
# .cache/trivy — trivy.db alone is over 1GB, well past GitHub's 100MB limit.
.cache/

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs & Reports ───────────────────────────────────────────────────────────
*.log
logs/
coverage/
*.lcov

# ─── PKI ceremony artifacts ──────────────────────────────────────────────────
# Generated by pki/offline-root-ceremony.sh — never commit CA keys/certs.
pki/export/

# scripts/pki/reissue-trust-anchors.sh scratch; post-rotate.sh writes the
# real certs from Terraform state.
terraform/pki/certs/staging/

# go build ./... in a main package drops the binary beside the source
apps/fml-pki/fml-pki

# google-github-actions/auth writes its credential file into the workspace.
gha-creds-*.json
