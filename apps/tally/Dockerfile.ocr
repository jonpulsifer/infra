# syntax=docker/dockerfile:1
#
# tally-ocr: tally's virtualenv with the `ocr` extra and Docling's models baked
# in, for the worker that runs with no egress. It serves no web, so it skips
# the Bun stages of Dockerfile; the Python stages match that file.
FROM python:3.13-slim-trixie@sha256:5dde09372dfa8e7762892b2a12619fcf6c23b0b78bce1058a9fa5a3a7a40e68e AS python
ENV PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1

FROM python AS venv
COPY --from=ghcr.io/astral-sh/uv:0.13.0@sha256:cdc6093146eb3ff6a40107b38f008b789e050e77ad87865e381d9917da55a168 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
  UV_LINK_MODE=copy \
  UV_PYTHON_DOWNLOADS=never \
  UV_PYTHON_PREFERENCE=only-system \
  UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /app/src
COPY apps/tally/pyproject.toml apps/tally/uv.lock apps/tally/.python-version apps/tally/README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --frozen --no-dev --extra ocr --no-install-project
COPY apps/tally/src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --frozen --no-dev --extra ocr --no-editable

# The worker has no egress, so the layout, table and OCR models ship in the
# image and the Hugging Face client never reaches for the network.
FROM venv AS models
RUN /app/.venv/bin/docling-tools models download -o /app/models

FROM python AS runner
ENV PATH=/app/.venv/bin:$PATH \
  DOCLING_ARTIFACTS_PATH=/app/models \
  HF_HUB_OFFLINE=1 \
  HF_HOME=/tmp/huggingface
WORKDIR /app
COPY --from=venv /app/.venv /app/.venv
COPY --from=models /app/models /app/models
RUN python -c "import docling, tally"
USER 65532:65532
CMD ["python", "-c", "import docling"]
