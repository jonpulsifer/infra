<?xml version="1.0" encoding="utf-8" ?>
<!--
  OhmGraphite in Prometheus mode, reading every motherboard, CPU, GPU and
  drive sensor through LibreHardwareMonitor.

  This exists because windows_exporter cannot do it. Its gpu collector reads
  Windows performance counters, which carry utilisation and memory but no
  temperature, power or clock; its thermalzone collector reads ACPI zones,
  which on a desktop board is one number that tracks nothing. Real sensors
  need the kernel driver LibreHardwareMonitor loads, which is why this runs as
  LocalSystem.

  Sensors are polled on scrape rather than on an interval, so `interval` does
  not apply in this mode.
-->
<configuration>
  <appSettings>
    <add key="type" value="prometheus" />
    <add key="prometheus_host" value="*" />
    <add key="prometheus_port" value="4445" />
    <add key="prometheus_path" value="metrics/" />
  </appSettings>
</configuration>
