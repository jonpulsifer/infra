<?xml version="1.0" encoding="utf-8"?>
<!--
  The package carries two programs: the tray, which is the app the user sees,
  and the agent, a Windows service the package registers as LocalSystem. The
  service needs the restricted packagedServices and localSystemServices
  capabilities, which a sideloaded package signed by a trusted certificate may
  declare. Build-Package.ps1 fills in the version.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop desktop6 rescap">

  <Identity Name="ca.lolwtf.Lookout" Publisher="CN=lolwtf.ca" Version="__VERSION__" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Lookout</DisplayName>
    <PublisherDisplayName>lolwtf.ca</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Keeps the lab's monitoring agents installed and current on this desktop.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Tray" Executable="Tray\Lookout.Tray.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Lookout"
        Description="The lab's monitoring agents on this desktop"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="Tray\Lookout.Tray.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="LookoutTray" Enabled="true" DisplayName="Lookout" />
        </desktop:Extension>
        <desktop6:Extension Category="windows.service" Executable="Agent\Lookout.Agent.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop6:Service Name="Lookout" StartupType="auto" StartAccount="localSystem" />
        </desktop6:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="packagedServices" />
    <rescap:Capability Name="localSystemServices" />
  </Capabilities>
</Package>
