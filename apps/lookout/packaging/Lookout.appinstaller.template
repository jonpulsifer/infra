<?xml version="1.0" encoding="utf-8"?>
<AppInstaller
  Uri="__BASE__/Lookout.appinstaller"
  Version="__VERSION__"
  xmlns="http://schemas.microsoft.com/appx/appinstaller/2018">
  <MainPackage
    Name="ca.lolwtf.Lookout"
    Publisher="CN=lolwtf.ca"
    Version="__VERSION__"
    ProcessorArchitecture="x64"
    Uri="__BASE__/Lookout.msix" />
  <UpdateSettings>
    <!-- The tray launches at every logon, so this is a daily check at most. -->
    <OnLaunch HoursBetweenUpdateChecks="12" />
    <AutomaticBackgroundTask />
    <ForceUpdateFromAnyVersion>true</ForceUpdateFromAnyVersion>
  </UpdateSettings>
</AppInstaller>
