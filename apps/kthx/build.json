[
  {
    "_comment": "The context is the repo root because the Dockerfile prunes the workspace; the watch list is what turbo prune actually pulls in.",
    "image": "kthx",
    "context": ".",
    "file": "apps/kthx/Dockerfile",
    "platforms": "linux/amd64",
    "no-cache-filters": "runner",
    "watch": [
      "apps/kthx",
      "packages/archive",
      "packages/kthx",
      "packages/typescript-config",
      "package.json",
      "bun.lock",
      "turbo.json"
    ]
  }
]
