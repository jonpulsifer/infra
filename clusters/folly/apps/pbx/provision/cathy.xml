<flat-profile>
  <!--
    Line 4 of the office SPA504G, and nothing else.

    An SPA flat profile is a PARTIAL config: the phone changes only the
    parameters named here and leaves every other one alone. That is the whole
    retention strategy — lines 1, 2 and 3 stay registered straight to voip.ms,
    byte for byte, because this file never mentions them.

    Named cathy.xml rather than using the $MA macro. $MA expands to the MAC in
    a case this config does not state, and a profile fetch that 404s is a
    resync that fails quietly every hour. There is one phone; name the file.

    Carries no credential. Line 4 authenticates to Asterisk by source address
    (pjsip.conf's `type = identify`), which is why this can be served over
    plain HTTP on the LAN.
  -->

  <!--
    Self-sustaining: after the one manual edit that points the phone here, the
    profile keeps it pointed here. Provision_Enable and the hourly
    Resync_Periodic are already set on the phone and are not restated.
  -->
  <Profile_Rule group="Provisioning/Configuration_Profile">http://${PBX_SIP_VIP}/cathy.xml</Profile_Rule>

  <!-- Registration moves from ca.voip.ms to the PBX. -->
  <Line_Enable_4_ group="Ext_4/General">Yes</Line_Enable_4_>
  <Proxy_4_ group="Ext_4/Proxy_and_Registration">${PBX_SIP_VIP}</Proxy_4_>
  <!--
    The outbound proxy was ca.voip.ms and has to be cleared, not just
    superseded: leave it set and every INVITE still goes to the carrier no
    matter what Proxy_4_ says.
  -->
  <Use_Outbound_Proxy_4_ group="Ext_4/Proxy_and_Registration">No</Use_Outbound_Proxy_4_>
  <Outbound_Proxy_4_ group="Ext_4/Proxy_and_Registration"></Outbound_Proxy_4_>
  <Register_4_ group="Ext_4/Proxy_and_Registration">Yes</Register_4_>
  <Register_Expires_4_ group="Ext_4/Proxy_and_Registration">300</Register_Expires_4_>

  <!--
    NAT traversal off, both of it. These exist so a handset can reach a carrier
    through a router; the PBX is two hops away on the same LAN. Left on, the
    phone advertises a discovered external address in its SDP and the media
    goes nowhere.
  -->
  <NAT_Mapping_Enable_4_ group="Ext_4/NAT_Settings">No</NAT_Mapping_Enable_4_>
  <NAT_Keep_Alive_Enable_4_ group="Ext_4/NAT_Settings">No</NAT_Keep_Alive_Enable_4_>

  <!-- Matches the endpoint name Asterisk knows. Password stays empty. -->
  <Display_Name_4_ group="Ext_4/Subscriber_Information">FML PBX</Display_Name_4_>
  <User_ID_4_ group="Ext_4/Subscriber_Information">cathy</User_ID_4_>
  <Password_4_ group="Ext_4/Subscriber_Information"></Password_4_>
  <Auth_ID_4_ group="Ext_4/Subscriber_Information"></Auth_ID_4_>

  <!--
    5063 is what this line already used, and it has to stay off 5060: lines 1-3
    share that port for their own registrations to voip.ms.
  -->
  <SIP_Port_4_ group="Ext_4/SIP_Settings">5063</SIP_Port_4_>

  <!--
    G722 is what every line on this phone already prefers, and Asterisk offers
    it first. Pref_Codec_Only stays No so a call that cannot do G722 falls back
    to ulaw rather than failing.
  -->
  <Preferred_Codec_4_ group="Ext_4/Audio_Configuration">G722</Preferred_Codec_4_>
  <Use_Pref_Codec_Only_4_ group="Ext_4/Audio_Configuration">No</Use_Pref_Codec_Only_4_>

  <!--
    Stop subscribing to BroadWorks call park on this line.

    BroadWorks is the carrier softswitch platform many ITSPs run, and
    x-broadworks-callpark is its proprietary SIP event package: the phone
    SUBSCRIBEs so the switch can tell it when a call is parked or comes back.
    The SPA504G turns that on per line by default. Asterisk is not BroadWorks
    and registers no handler for the event, so it refuses each SUBSCRIBE and
    logs a warning — every thirty seconds, forever.

    Harmless, and entirely cosmetic: it touches no call. It is switched off
    because a log line that means nothing trains you to ignore the log.

    Line 4 only. Lines 1-3 still talk to voip.ms and keep whatever they had.
  -->
  <Call_Park_Monitor_Enable_4_ group="Ext_4/Call_Feature_Settings">No</Call_Park_Monitor_Enable_4_>

  <!-- The line key's label. Dial_Plan_4_ is deliberately absent: the plan the
       phone already has is the one that works. -->
  <Short_Name_4_ group="Phone/Line_Key_4">PBX</Short_Name_4_>
</flat-profile>
