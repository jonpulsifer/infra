<flat-profile>
  <!--
    The office SPA504G, all four lines, each registered to the folly PBX.

    The phone talks only to the PBX and holds no voip.ms credential: every
    Password here is empty. Each line registers as lineN, and the PBX tells the
    lines apart by that username and admits them only from the phone's reserved
    address (clusters/folly/apps/pbx/config/pjsip.conf). That is what makes it
    acceptable to serve this file over plain HTTP on the LAN.

    An SPA flat profile is PARTIAL: the phone changes only the parameters named
    here and leaves every other one alone — dial plans, codecs, display names,
    line-key labels 1-3 all stay as the phone has them. Change a setting by
    adding it here, never by hand on the phone: the next hourly resync wins.

    Named cathy.xml rather than using the MA (MAC address) macro, whose case this config
    does not state; a profile fetch that 404s is a resync that fails quietly.

    Consequence worth knowing: with every line on the PBX, dial tone and 911 on
    this phone depend on folly being up. That is a deliberate choice, recorded
    in docs/runbooks/operate-the-office-phone.md.
  -->

  <!-- Self-sustaining: keeps the phone pointed here after the first nudge. -->
  <Profile_Rule group="Provisioning/Configuration_Profile">http://${PBX_SIP_VIP}/cathy.xml</Profile_Rule>

  <!--
    Phone-wide: silence the secure-call tone. It is the beep that seemed to come
    with HD audio, but it marks encryption, and every call is both G.722 and
    SRTP. Encryption itself stays on (Secure_Call_Setting is untouched).
  -->
  <Secure_Call_Indication_Tone group="Regional/Call_Progress_Tones"></Secure_Call_Indication_Tone>

  <!--
    Per line. SIP ports stay what the phone has always used: lines 1-3 share
    5060, line 4 is on 5063 — the PBX's egress policy opens exactly those.
    Register every 60s, because registrations live in an emptyDir and every PBX
    rollout forgets the phone until its next REGISTER. NAT traversal off: the
    PBX is two hops away on the LAN. BroadWorks call-park subscription off:
    Asterisk has no handler for it and logs a warning every thirty seconds.
  -->

  <!-- Line 1 — Jonathan Pulsifer, 168847_cathy -->
  <Line_Enable_1_ group="Ext_1/General">Yes</Line_Enable_1_>
  <Proxy_1_ group="Ext_1/Proxy_and_Registration">${PBX_SIP_VIP}</Proxy_1_>
  <Use_Outbound_Proxy_1_ group="Ext_1/Proxy_and_Registration">No</Use_Outbound_Proxy_1_>
  <Outbound_Proxy_1_ group="Ext_1/Proxy_and_Registration"></Outbound_Proxy_1_>
  <Register_1_ group="Ext_1/Proxy_and_Registration">Yes</Register_1_>
  <Register_Expires_1_ group="Ext_1/Proxy_and_Registration">60</Register_Expires_1_>
  <NAT_Mapping_Enable_1_ group="Ext_1/NAT_Settings">No</NAT_Mapping_Enable_1_>
  <NAT_Keep_Alive_Enable_1_ group="Ext_1/NAT_Settings">No</NAT_Keep_Alive_Enable_1_>
  <User_ID_1_ group="Ext_1/Subscriber_Information">line1</User_ID_1_>
  <Password_1_ group="Ext_1/Subscriber_Information"></Password_1_>
  <Auth_ID_1_ group="Ext_1/Subscriber_Information"></Auth_ID_1_>
  <SIP_Port_1_ group="Ext_1/SIP_Settings">5060</SIP_Port_1_>
  <Call_Park_Monitor_Enable_1_ group="Ext_1/Call_Feature_Settings">No</Call_Park_Monitor_Enable_1_>

  <!-- Line 2 — Recorded, 168847_recorded -->
  <Line_Enable_2_ group="Ext_2/General">Yes</Line_Enable_2_>
  <Proxy_2_ group="Ext_2/Proxy_and_Registration">${PBX_SIP_VIP}</Proxy_2_>
  <Use_Outbound_Proxy_2_ group="Ext_2/Proxy_and_Registration">No</Use_Outbound_Proxy_2_>
  <Outbound_Proxy_2_ group="Ext_2/Proxy_and_Registration"></Outbound_Proxy_2_>
  <Register_2_ group="Ext_2/Proxy_and_Registration">Yes</Register_2_>
  <Register_Expires_2_ group="Ext_2/Proxy_and_Registration">60</Register_Expires_2_>
  <NAT_Mapping_Enable_2_ group="Ext_2/NAT_Settings">No</NAT_Mapping_Enable_2_>
  <NAT_Keep_Alive_Enable_2_ group="Ext_2/NAT_Settings">No</NAT_Keep_Alive_Enable_2_>
  <User_ID_2_ group="Ext_2/Subscriber_Information">line2</User_ID_2_>
  <Password_2_ group="Ext_2/Subscriber_Information"></Password_2_>
  <Auth_ID_2_ group="Ext_2/Subscriber_Information"></Auth_ID_2_>
  <SIP_Port_2_ group="Ext_2/SIP_Settings">5060</SIP_Port_2_>
  <Call_Park_Monitor_Enable_2_ group="Ext_2/Call_Feature_Settings">No</Call_Park_Monitor_Enable_2_>

  <!-- Line 3 — FML, 168847_sandbox -->
  <Line_Enable_3_ group="Ext_3/General">Yes</Line_Enable_3_>
  <Proxy_3_ group="Ext_3/Proxy_and_Registration">${PBX_SIP_VIP}</Proxy_3_>
  <Use_Outbound_Proxy_3_ group="Ext_3/Proxy_and_Registration">No</Use_Outbound_Proxy_3_>
  <Outbound_Proxy_3_ group="Ext_3/Proxy_and_Registration"></Outbound_Proxy_3_>
  <Register_3_ group="Ext_3/Proxy_and_Registration">Yes</Register_3_>
  <Register_Expires_3_ group="Ext_3/Proxy_and_Registration">60</Register_Expires_3_>
  <NAT_Mapping_Enable_3_ group="Ext_3/NAT_Settings">No</NAT_Mapping_Enable_3_>
  <NAT_Keep_Alive_Enable_3_ group="Ext_3/NAT_Settings">No</NAT_Keep_Alive_Enable_3_>
  <User_ID_3_ group="Ext_3/Subscriber_Information">line3</User_ID_3_>
  <Password_3_ group="Ext_3/Subscriber_Information"></Password_3_>
  <Auth_ID_3_ group="Ext_3/Subscriber_Information"></Auth_ID_3_>
  <SIP_Port_3_ group="Ext_3/SIP_Settings">5060</SIP_Port_3_>
  <Call_Park_Monitor_Enable_3_ group="Ext_3/Call_Feature_Settings">No</Call_Park_Monitor_Enable_3_>

  <!-- Line 4 — 826-1994, 168847_1994 -->
  <Line_Enable_4_ group="Ext_4/General">Yes</Line_Enable_4_>
  <Proxy_4_ group="Ext_4/Proxy_and_Registration">${PBX_SIP_VIP}</Proxy_4_>
  <Use_Outbound_Proxy_4_ group="Ext_4/Proxy_and_Registration">No</Use_Outbound_Proxy_4_>
  <Outbound_Proxy_4_ group="Ext_4/Proxy_and_Registration"></Outbound_Proxy_4_>
  <Register_4_ group="Ext_4/Proxy_and_Registration">Yes</Register_4_>
  <Register_Expires_4_ group="Ext_4/Proxy_and_Registration">60</Register_Expires_4_>
  <NAT_Mapping_Enable_4_ group="Ext_4/NAT_Settings">No</NAT_Mapping_Enable_4_>
  <NAT_Keep_Alive_Enable_4_ group="Ext_4/NAT_Settings">No</NAT_Keep_Alive_Enable_4_>
  <User_ID_4_ group="Ext_4/Subscriber_Information">line4</User_ID_4_>
  <Password_4_ group="Ext_4/Subscriber_Information"></Password_4_>
  <Auth_ID_4_ group="Ext_4/Subscriber_Information"></Auth_ID_4_>
  <SIP_Port_4_ group="Ext_4/SIP_Settings">5063</SIP_Port_4_>
  <Call_Park_Monitor_Enable_4_ group="Ext_4/Call_Feature_Settings">No</Call_Park_Monitor_Enable_4_>

  <!-- Line 4 is the one line whose key label this file sets, back to its DID. -->
  <Short_Name_4_ group="Phone/Line_Key_4">826-1994</Short_Name_4_>
</flat-profile>
