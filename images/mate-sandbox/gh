#!/bin/sh
# Baked into the sandbox image at /usr/local/bin/gh, in front of the real
# binary at the path below.
#
# Only git consults a git credential helper, and a helper is the whole of what
# the harness container is handed. gh looks for a token in GH_TOKEN, in
# GITHUB_TOKEN or in its own hosts.yml, finds none of the three, and answers
# every subcommand with its own login instructions — so a sandbox that can push
# a branch stops one step short of the pull request the push was for. This
# reads the same file git's helper reads and hands the token to gh in its
# environment, which keeps what that helper bought: the token is inside one
# process for the length of one command instead of in the pod's environment for
# the length of the thread. It is not out of the agent's reach and is not meant
# to be — the file is readable, and the agent can read /proc/<pid>/environ of a
# gh it started. What the sandbox is protected by is what the token is worth:
# one hour, one repository, three narrow permissions, and handed back within
# seconds of the turn ending.
#
# /usr/local/libexec, rather than the real binary keeping a name of its own
# beside this one: the wrapper has to be what PATH finds, /usr/local/bin is
# already the first entry in Debian's own PATH, and a directory prepended at
# runtime does not survive the login shells opencode spawns.
set -eu

REAL=/usr/local/libexec/gh

# An inherited GH_TOKEN wins, which settles two cases at once: an agent that
# exported a token of its own keeps it, and a gh that shells out to gh — an
# extension, a script it runs — inherits the token already resolved rather than
# going back for a second copy.
if [ -z "${GH_TOKEN:-}" ] && [ -n "${MATE_GITHUB_TOKEN_FILE:-}" ]; then
  # Two ways this read comes back with nothing and neither is an error the
  # shell would raise on its own. The file is absent until mate stamps the
  # turn's token into it, which is every moment before the first turn and
  # after the last one; and it is deliberately truncated at the end of a turn,
  # so an empty file is the normal resting state rather than a fault. Both
  # have to count as no credential: exporting an empty GH_TOKEN makes gh print
  # the same "please run gh auth login" it printed before this wrapper
  # existed, and the answer an agent needs is "there is no token right now",
  # not "the wrapper is not installed".
  if token=$(cat "$MATE_GITHUB_TOKEN_FILE" 2>/dev/null) && [ -n "$token" ]; then
    GH_TOKEN=$token
    export GH_TOKEN
  else
    # Unauthenticated rather than fatal, because a hard exit here would take
    # `gh --version` and `gh --help` down alongside the commands that need a
    # token, and gh is about to report the missing credential itself in less
    # useful words than these.
    echo "gh: no token in $MATE_GITHUB_TOKEN_FILE; continuing unauthenticated" >&2
  fi
fi

# exec, so gh owns the signals and the exit status, and so nothing outlives it
# still holding the token.
exec "$REAL" "$@"
