#!/usr/bin/env bash

set -u

CLUSTERS=("folly" "offsite")
# The repo checkout this script is linked from. A NixOS closure carries only
# dotfiles/, so there the topology comes from main on GitHub.
INFRA_DIR="${INFRA_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)}"
TOPOLOGY_URL="https://raw.githubusercontent.com/jonpulsifer/infra/main"

# Prints API_SERVER_IP: the control plane, which is the SSH host, the Talos
# node the kubeconfig is asked of, and the kubeconfig server.
get_cluster_ip() {
  local topology="clusters/$1/config/cluster-topology.json"
  if [[ -r "$INFRA_DIR/$topology" ]]; then
    jq -er '.data.API_SERVER_IP' "$INFRA_DIR/$topology"
  else
    curl -fsS --max-time 10 "$TOPOLOGY_URL/$topology" | jq -er '.data.API_SERVER_IP'
  fi
}

# True when the operator's talosconfig (~/.talos/config, or $TALOSCONFIG) holds
# a context named for the cluster. That context is the os:admin credential from
# the 1Password item `talos-<cluster>-admin`, and it selects the Talos path:
# the admin kubeconfig comes from `talosctl kubeconfig` instead of ssh, and
# `kube-jit-token` mints locally as the certificate user it yields. With no
# such context the cluster is fetched over ssh, as a NixOS control plane is.
talos_context() {
  command -v talosctl >/dev/null 2>&1 \
    && talosctl config info --context "$1" >/dev/null 2>&1
}

# `talos` or `ssh`, for the summary and the help.
fetch_path() {
  if talos_context "$1"; then echo talos; else echo ssh; fi
}

# Honour KUBECONFIG when it names one file. Without this the script writes to
# ~/.kube/config while every kubectl it then runs — including its own summary —
# reads whatever KUBECONFIG points at, so the two can silently disagree. A
# colon-list has no single file to write, so the first entry wins, which is the
# one kubectl would write to as well.
KUBECONFIG_PATH="${KUBECONFIG%%:*}"
KUBECONFIG_PATH="${KUBECONFIG_PATH:-$HOME/.kube/config}"
# The credential plugin kubectl runs to mint a token. An absolute path, because
# kubectl execs it without a shell and with no guarantee about PATH.
JIT_HELPER="${JIT_HELPER:-$HOME/.local/bin/kube-jit-token}"
TEMP_DIR=$(mktemp -d)
BACKUP_PATH="$HOME/.kube/config.backup.$(date +%Y%m%d-%H%M%S)"
SSH_CONNECT_TIMEOUT="${SSH_CONNECT_TIMEOUT:-5}"
SSH_COMMAND_TIMEOUT="${SSH_COMMAND_TIMEOUT:-20}"
TALOS_COMMAND_TIMEOUT="${TALOS_COMMAND_TIMEOUT:-20}"
SSH_OPTS=(
  -o BatchMode=yes
  -o ConnectTimeout="$SSH_CONNECT_TIMEOUT"
  -o ConnectionAttempts=1
  -o ServerAliveInterval=5
  -o ServerAliveCountMax=1
)

# Runs a command under a deadline in seconds, or unbounded where coreutils'
# timeout is missing, so an unreachable cluster cannot stall the whole update.
with_deadline() {
  local seconds="$1"
  shift
  if command -v timeout &>/dev/null; then
    timeout "${seconds}s" "$@"
  else
    "$@"
  fi
}

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log() {
  echo -e "${BLUE}[$(date '+%Y-%m-%d %H:%M:%S')]${NC} $1"
}

error() {
  echo -e "${RED}[ERROR]${NC} $1" >&2
}

warn() {
  echo -e "${YELLOW}[WARN]${NC} $1"
}

success() {
  echo -e "${GREEN}[SUCCESS]${NC} $1"
}

cleanup() {
  log "Cleaning up temporary files..."
  rm -rf "$TEMP_DIR"
}

trap cleanup EXIT

# Function to fetch and process kubeconfig from a cluster
fetch_and_process_kubeconfig() {
  local cluster_name="$1"
  local ip
  ip=$(get_cluster_ip "$cluster_name") || {
    error "No API_SERVER_IP for $cluster_name in its cluster-topology.json"
    return 1
  }
  local temp_config="$TEMP_DIR/kubeconfig-$cluster_name"
  local original="$TEMP_DIR/$cluster_name-original.json"

  if talos_context "$cluster_name"; then
    log "Fetching kubeconfig from $cluster_name ($ip) through the Talos API..."
    # `--merge=false -` writes the admin kubeconfig to stdout. Its one user is
    # the admin certificate, so `--minify` keeps everything.
    if ! with_deadline "$TALOS_COMMAND_TIMEOUT" talosctl --context "$cluster_name" --nodes "$ip" kubeconfig --merge=false - >"$TEMP_DIR/$cluster_name-talos.yaml"; then
      error "Failed to fetch kubeconfig from $cluster_name ($ip) with talosctl within ${TALOS_COMMAND_TIMEOUT}s"
      return 1
    fi
    if ! kubectl config view --kubeconfig="$TEMP_DIR/$cluster_name-talos.yaml" --minify --flatten --output=json >"$original"; then
      error "talosctl returned no kubeconfig for $cluster_name ($ip)"
      return 1
    fi
  else
    log "Fetching kubeconfig from $cluster_name ($ip) over ssh..."
    if ! command -v ssh &>/dev/null; then
      error "ssh is required for $cluster_name, which has no context in the talosconfig"
      return 1
    fi

    # Fetch the kubeconfig in JSON format for easier processing. Bound both the
    # SSH connection attempt and the whole remote command so unavailable clusters
    # do not stall the entire update.
    if ! with_deadline "$SSH_COMMAND_TIMEOUT" ssh "${SSH_OPTS[@]}" "$ip" -- sudo kubectl config view --minify --flatten --output=json >"$original"; then
      error "Failed to fetch kubeconfig from $cluster_name ($ip) within ${SSH_COMMAND_TIMEOUT}s"
      return 1
    fi
  fi

  # Check if the file is empty or invalid
  if [[ ! -s "$original" ]]; then
    error "Received empty kubeconfig from $cluster_name ($ip)"
    return 1
  fi

  log "Processing kubeconfig for $cluster_name..."

  # Process the JSON kubeconfig using jq.
  #
  # Two users come out of one fetched config. The context points at the JIT one:
  # `kube-jit-token` mints a short-lived token on demand, so nothing durable is
  # written here and access is withdrawn by deleting the ServiceAccount or its
  # binding (clusters/base/operator-rbac.yaml). KUBE_JIT_CLUSTER tells it which
  # cluster the mint is for; on the Talos path it mints as the breakglass user
  # below, otherwise through the host in its arguments.
  #
  # The certificate that was fetched stays as `<cluster>-breakglass`. It is
  # `O=system:masters`, which the apiserver cannot revoke and RBAC cannot bound,
  # so it is not what day-to-day kubectl should carry — but it authenticates
  # through a separate authenticator from the token chain, which is exactly what
  # is wanted when the token path is the thing that is broken.
  if ! jq --arg cluster_name "$cluster_name" --arg ip "$ip" --arg jit "$JIT_HELPER" '
        .clusters[0].name = $cluster_name |
        .clusters[0].cluster.server = "https://\($ip):6443" |
        .contexts[0].name = $cluster_name |
        .contexts[0].context.cluster = $cluster_name |
        .contexts[0].context.user = $cluster_name |
        .users[0].name = "\($cluster_name)-breakglass" |
        .users += [{
          name: $cluster_name,
          user: {
            exec: {
              apiVersion: "client.authentication.k8s.io/v1",
              command: $jit,
              args: [$ip, "operator", "kube-system", "8h"],
              env: [{name: "KUBE_JIT_CLUSTER", value: $cluster_name}],
              interactiveMode: "Never"
            }
          }
        }] |
        .["current-context"] = $cluster_name
    ' "$original" >"$TEMP_DIR/$cluster_name-processed.json"; then
    error "Failed to process JSON for $cluster_name"
    return 1
  fi

  # Convert back to YAML for kubectl compatibility
  # No --minify here: it keeps only what the current context references, which
  # would drop the breakglass user added above. The fetched config is already a
  # single cluster, so there is nothing for it to trim anyway.
  if ! kubectl config view --kubeconfig="$TEMP_DIR/$cluster_name-processed.json" --flatten >"$temp_config"; then
    error "Failed to convert to YAML for $cluster_name"
    return 1
  fi

  if [[ ! -s "$temp_config" ]]; then
    error "Failed to process kubeconfig for $cluster_name"
    return 1
  fi

  success "Processed kubeconfig for $cluster_name (server: https://$ip:6443)"
  return 0
}

# Function to merge all kubeconfigs using kubectl
merge_kubeconfigs() {
  log "Merging kubeconfigs..." >&2

  local temp_kubeconfigs=()
  for cluster_name in "${CLUSTERS[@]}"; do
    local temp_config="$TEMP_DIR/kubeconfig-$cluster_name"

    if [[ -f "$temp_config" ]]; then
      temp_kubeconfigs+=("$temp_config")
      log "Will merge: $temp_config" >&2
    else
      warn "Skipping $cluster_name - kubeconfig not available"
    fi
  done

  if [[ ${#temp_kubeconfigs[@]} -eq 0 ]]; then
    error "No kubeconfigs were successfully processed"
    return 1
  fi

  log "Merging ${#temp_kubeconfigs[@]} kubeconfig(s)..." >&2

  # Use KUBECONFIG environment variable to merge configs
  local kubeconfig_list
  kubeconfig_list=$(
    IFS=:
    echo "${temp_kubeconfigs[*]}"
  )
  local merged_config="$TEMP_DIR/merged-kubeconfig"

  log "KUBECONFIG list: $kubeconfig_list" >&2

  if ! KUBECONFIG="$kubeconfig_list" kubectl config view --flatten >"$merged_config" 2>/dev/null; then
    error "Failed to merge kubeconfigs"
    return 1
  fi

  # Set the first context as current if no current context is set
  if ! KUBECONFIG="$merged_config" kubectl config current-context &>/dev/null; then
    local first_context
    first_context=$(KUBECONFIG="$merged_config" kubectl config get-contexts -o name | head -n1)
    if [[ -n "$first_context" ]]; then
      log "Setting current context to: $first_context" >&2
      KUBECONFIG="$merged_config" kubectl config use-context "$first_context" >/dev/null
    fi
  fi

  echo "$merged_config"
}

# Main execution
main() {
  log "Starting kubeconfig update process..."

  # Check dependencies
  if ! command -v jq &>/dev/null; then
    error "jq is required but not installed. Please install jq first."
    exit 1
  fi

  if ! command -v kubectl &>/dev/null; then
    error "kubectl is required but not installed."
    exit 1
  fi
  # ssh and talosctl are checked per cluster, since each cluster needs one of them.

  # Create .kube directory if it doesn't exist
  mkdir -p "$(dirname "$KUBECONFIG_PATH")"

  # Backup existing kubeconfig if it exists
  if [[ -f "$KUBECONFIG_PATH" ]]; then
    log "Backing up existing kubeconfig to $BACKUP_PATH"
    cp "$KUBECONFIG_PATH" "$BACKUP_PATH"
  fi

  # Process each cluster in parallel. Each job writes to its own log so output is
  # still readable while the slow/unavailable clusters are bounded by timeouts.
  # PID→cluster mapping uses temp files to avoid bash 4+ associative arrays.
  local successful_clusters=0
  local pids=()

  log "About to process ${#CLUSTERS[@]} clusters in parallel: ${CLUSTERS[*]}"
  for cluster_name in "${CLUSTERS[@]}"; do
    local job_log="$TEMP_DIR/$cluster_name.log"

    log "Starting processing for cluster: $cluster_name"
    fetch_and_process_kubeconfig "$cluster_name" >"$job_log" 2>&1 &
    local pid=$!
    pids+=("$pid")
    echo "$cluster_name" >"$TEMP_DIR/pid-$pid"
  done

  for pid in "${pids[@]}"; do
    local cluster_name
    cluster_name=$(cat "$TEMP_DIR/pid-$pid")
    local job_log="$TEMP_DIR/$cluster_name.log"

    if wait "$pid"; then
      successful_clusters=$((successful_clusters + 1))
      while IFS= read -r line; do
        echo "[$cluster_name] $line"
      done <"$job_log"
      log "SUCCESS: Cluster $cluster_name processed successfully"
    else
      while IFS= read -r line; do
        echo "[$cluster_name] $line"
      done <"$job_log"
      warn "Failed to process kubeconfig from $cluster_name"
    fi
  done

  log "Completed cluster processing (successful: $successful_clusters/${#CLUSTERS[@]})"

  if [[ $successful_clusters -eq 0 ]]; then
    error "No kubeconfigs were successfully fetched"
    exit 1
  fi

  log "Successfully processed $successful_clusters kubeconfig(s)"

  # Merge all kubeconfigs
  local merged_config
  if merged_config=$(merge_kubeconfigs); then
    mv "$merged_config" "$KUBECONFIG_PATH"
    success "Successfully updated kubeconfig at $KUBECONFIG_PATH"

    # Show summary
    log "Available contexts:"
    kubectl config get-contexts --no-headers | while IFS= read -r line; do
      echo "  $line"
    done

    local current_context
    current_context=$(kubectl config current-context 2>/dev/null || echo "none")
    log "Current context: $current_context"

    # Show cluster info
    log "Cluster information:"
    for cluster_name in "${CLUSTERS[@]}"; do
      if kubectl config get-contexts -o name | grep -q "^${cluster_name}$"; then
        local server
        server=$(kubectl config view -o jsonpath="{.clusters[?(@.name=='$cluster_name')].cluster.server}" 2>/dev/null || echo "unknown")
        echo "  $cluster_name: $server"
      fi
    done
  else
    error "Failed to merge kubeconfigs"
    exit 1
  fi
}

# Show help
show_help() {
  cat <<EOF
Usage: $0 [OPTIONS]

Update kubeconfig by fetching and merging configs from multiple Kubernetes clusters via direct IP.

OPTIONS:
    -h, --help     Show this help message
    -l, --list     List configured clusters, and how each is fetched

ENVIRONMENT:
    TALOSCONFIG           the talosconfig (default: ~/.talos/config); a cluster
                          whose name is a context in it takes the Talos path
    TALOS_COMMAND_TIMEOUT Whole talosctl fetch timeout in seconds (default: 20)
    SSH_CONNECT_TIMEOUT   SSH connection timeout in seconds (default: 5)
    SSH_COMMAND_TIMEOUT   Whole remote fetch timeout in seconds (default: 20)
    INFRA_DIR             repo checkout to read cluster-topology.json from
                          (default: the one this script is linked from; with
                          none, main on GitHub)

CONFIGURED CLUSTERS:
$(for cluster_name in "${CLUSTERS[@]}"; do
    echo "  $cluster_name: $(get_cluster_ip "$cluster_name") ($(fetch_path "$cluster_name"))"
  done)

The script will:
1. Fetch the admin kubeconfig of each cluster: with talosctl, through the
   os:admin context of the same name in the talosconfig (the 1Password item
   talos-<cluster>-admin), or over SSH to the control plane when there is none
2. Rename clusters/contexts/users to avoid conflicts
3. Update server URLs to use direct IP addresses
4. Point each context at a JIT credential, and keep the fetched certificate
   beside it as <cluster>-breakglass
5. Merge all configs into ~/.kube/config using kubectl
6. Create a backup of the existing config

CREDENTIALS:
Each context authenticates through kube-jit-token, which mints a short-lived
ServiceAccount token when kubectl asks for one: as the <cluster>-breakglass
user on the Talos path, through the control plane over SSH otherwise. Access
is withdrawn by deleting the ServiceAccount or its ClusterRoleBinding.

The fetched cluster-admin certificate is kept as <cluster>-breakglass for when
the token path itself is broken:

    kubectl --context folly --user folly-breakglass get nodes

ENVIRONMENT:
    JIT_HELPER   path to kube-jit-token (default: ~/.local/bin/kube-jit-token)

DEPENDENCIES:
- kubectl (for kubeconfig manipulation)
- jq (for JSON processing)
- talosctl (for a cluster with a talosconfig context)
- ssh (for a cluster without one)
- curl (when no checkout holds cluster-topology.json)

EOF
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      show_help
      exit 0
      ;;
    -l | --list)
      echo "Configured clusters:"
      for cluster_name in "${CLUSTERS[@]}"; do
        echo "  $cluster_name: $(get_cluster_ip "$cluster_name") ($(fetch_path "$cluster_name"))"
      done
      exit 0
      ;;
    --dry-run)
      log "DRY RUN MODE - No changes will be made"
      warn "Dry run mode not yet implemented"
      exit 0
      ;;
    *)
      error "Unknown option: $1"
      show_help
      exit 1
      ;;
  esac
done

main
