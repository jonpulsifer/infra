vars: {d2-config: {theme-id: 0; pad: 24}}
shape: sequence_diagram
node: "Node agent"
fleet: fleetd
netbox: NetBox
applier: "Entry applier"
spire: SPIRE
pod: Workload
fleet -> netbox: "1. Read status and verdict" {style.font-size: 24}
fleet -> applier: "2. Export eligible nodes" {style.font-size: 24}
applier -> spire: "3. Reconcile fleet entries" {style.font-size: 24}
node -> spire: "4. LDevID or EK proof" {style.font-size: 24}
spire -> node: "5. Agent identity" {style.font-size: 24}
pod -> node: "6. Request workload identity" {style.font-size: 24}
node -> pod: "7. SVID when selectors match" {style.font-size: 24}
node -> fleet: "8. Daily boot evidence" {style.font-size: 24}
fleet -> netbox: "9. Record verdict" {style.font-size: 24}
netbox -> fleet: "10. Node becomes ineligible" {style.font-size: 24}
fleet -> applier: "11. Export without this node" {style.font-size: 24}
applier -> spire: "12. Remove entries; conditional eviction" {style.font-size: 24}
spire -> spire: "13. Other access paths remain separate" {style.font-size: 24}
**.style.font-size: 24
