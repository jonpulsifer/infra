vars: {d2-config: {layout-engine: elk; theme-id: 0; pad: 24}}
direction: right
facts: "Owner + Git\nNetBox on capsule\nDeclarations and actions"
control: "Management on spore\nfleetd + YubiKey\nBoot services + Tinkerbell"
node: "Node boundary\nFirmware + TPM\nHookOS then Talos"
identity: "Identity boundary\nSPIRE on spore\nAgent and workload on node"
resource: "Resource boundary\nGCP IAM or\nservice policy"
facts -> control: desired state
control -> node: authorized install
node -> identity: node proof
identity -> resource: workload credential
**.style.font-size: 24
