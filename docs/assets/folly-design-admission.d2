node -> fleet: "4. TPM evidence and certified key"
fleet -> fleet: "5. Check quote, log and policy"
fleet -> node: "6. LDevID and LAK certificates"
node -> fleet: "7. Signed confirmation"
fleet -> netbox: "8. Check admission and port report"
fleet -> tink: "9. Reuse or create authorized provision"
fleet -> fleet: "10. Render eligible config"
