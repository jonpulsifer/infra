# kthx built apps: the Vessels, their Targets, and the GCP projects the
# engine federates into.

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    dark-theme-id: 200
    pad: 20
  }
}

direction: down

control: "kthx engine — a Flux-managed workload on offsite" {
  style.fill-pattern: dots
  grid-columns: 3
  web: web
  rec: reconciler
  db: Postgres {shape: cylinder}
}

cloud: "GCP — bluenose and trusted-builds" {
  grid-columns: 3
  kms: "KMS signer (trusted-builds)\nsigns each image digest" {shape: hexagon}
  reg: "Artifact Registry repository i (trusted-builds)\nVessels can only pull" {shape: cylinder}
  sm: "Secret Manager (bluenose)\nApp config" {shape: cylinder}
}

# The grid fills column by column, so this order puts the three Targets that
# GCP feeds on the first row.
targets: "Targets on each Vessel" {
  grid-columns: 3

  fk: "folly cluster: kubernetes" {
    grid-columns: 1
    ns: "HelmRelease or Argo CD Application → app-<app>"
    kyverno: Kyverno {shape: hexagon}
    ess: gcp-secret-manager store
  }
  st: "bluenose project: static" {
    grid-columns: 1
    site: Firebase Hosting release
  }
  ok: "offsite cluster: kubernetes" {
    grid-columns: 1
    ns: "HelmRelease or Argo CD Application → app-<app>"
    kyverno: Kyverno {shape: hexagon}
    ess: gcp-secret-manager store
  }
  vc: "Vercel team: vercel" {
    grid-columns: 1
    dep: prebuilt deployment
  }
  cr: "bluenose project: cloudrun" {
    grid-columns: 1
    svc: Service revision
    ba: Binary Authorization {shape: hexagon}
    ref: secret reference, resolved in-project
  }
  cf: "Cloudflare account: cloudflare-pages" {
    grid-columns: 1
    dep: Pages deployment
  }
}

control -> cloud.sm: writes config, keeps a pinned reference
control -> cloud.kms: verifies provenance, then signs
control -> cloud: federates through fml-pool {style.stroke-dash: 4}
control -> targets: "deploys through the cluster, runtime and edge APIs" {style.bold: true}

cloud.reg -> targets.fk.kyverno
cloud.reg -> targets.ok.kyverno
cloud.reg -> targets.cr.ba

cloud.sm -> targets.fk.ess
cloud.sm -> targets.ok.ess
cloud.sm -> targets.cr.ref
